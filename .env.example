# Local development only. Staging and production read secrets from the platform store, never a committed .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/team_impact
SESSION_SECRET=change-me-to-at-least-32-random-characters
PORT=3000
# Set to 1 to serve fixture data instead of the database (no DATABASE_URL needed). `pnpm dev:mock` does this.
MOCK_API=0
# Kill switches (PRD §11). Both on for the pilot.
FLAG_IDENTITY_SEARCH=true
FLAG_MEDICAL_COMMUNITIES=true
# Auth (TI-101, Better Auth). Where the API is reached; emailed links point here first.
API_URL=http://localhost:3000
# Where those links land: recruiters and staff on the portal, everyone else the athlete app.
PORTAL_URL=http://localhost:5173
ATHLETE_APP_URL=http://localhost:8081
# Leave unset locally: verification and reset emails (with their links) print in the API log.
# Required in production. Any SMTP provider works.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=Team Impact <no-reply@teamimpact.org>
