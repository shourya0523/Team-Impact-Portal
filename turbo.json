{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["MOCK_API", "FLAG_*"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["DATABASE_URL"]
    }
  }
}
